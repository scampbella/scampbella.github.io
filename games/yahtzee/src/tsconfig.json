{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "outDir": "../build",
    "rootDir": ".",
    "strict": true,
    "noImplicitReturns": false,
    "removeComments": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["*.ts"]
}
